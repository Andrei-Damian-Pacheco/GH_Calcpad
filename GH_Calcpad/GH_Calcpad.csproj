<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.gha</TargetExt>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyTitle>GH_Calcpad</AssemblyTitle>
    <Description>Complete Calcpad integration in Grasshopper with optimization</Description>
    <Company>Andrei Damian Pacheco</Company>
    <Product>GH_Calcpad</Product>
    <Version>2.0.0</Version>
    <BaseOutputPath>C:\Users\USER\AppData\Roaming\Grasshopper\Libraries\Debug\net48</BaseOutputPath>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Syntaxis\calcpad.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.21.25188.17001" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared JSON wire contract with Worker\GH_Calcpad.Worker (netstandard2.0, consumable from net48). -->
    <ProjectReference Include="..\Worker\GH_Calcpad.Protocol\GH_Calcpad.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <WorkerProjectDir>$(MSBuildThisFileDirectory)..\Worker\GH_Calcpad.Worker\</WorkerProjectDir>
    <WorkerProject>$(WorkerProjectDir)GH_Calcpad.Worker.csproj</WorkerProject>
  </PropertyGroup>

  <!--
    The plugin process (net48) can't run the net10 worker in-process - it talks to
    it over a named pipe as a separate GH_Calcpad.Worker.exe (see
    GH_Calcpad\Classes\CalcpadWorkerClient.cs). This target builds the worker
    (framework-dependent - fine for local dev, this machine already has the .NET 10
    runtime) and copies its output into "$(TargetDir)Worker\" after every build.

    IMPORTANT: this MUST be its own subfolder, not $(TargetDir) directly, in case
    anything ever needs to share a name with a file the worker also ships (the
    project used to also vendor an old in-process Libraries\Calcpad.Core.dll here,
    which is exactly what caused "Could not load file or assembly
    'Calcpad.Core, Version=7.6.3.0'..." - that dependency is gone now that Load CPD's
    debug HTML and the Export components both go through the worker instead, but the
    isolated subfolder stays as a cheap guard against the same class of bug).

    PackageZip below does a proper self-contained publish for actual distribution,
    also isolated into its own subfolder for the same reason.
  -->
  <PropertyGroup>
    <WorkerOutputSubfolder>Worker\</WorkerOutputSubfolder>
  </PropertyGroup>

  <Target Name="BuildAndCopyWorker" AfterTargets="Build">
    <Exec Command="dotnet build &quot;$(WorkerProject)&quot; -c $(Configuration)" />
    <ItemGroup>
      <WorkerOutput Include="$(WorkerProjectDir)bin\$(Configuration)\net10.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerOutput)" DestinationFolder="$(TargetDir)$(WorkerOutputSubfolder)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <DesktopPath>$(UserProfile)\Desktop</DesktopPath>
    <DistDir>$(DesktopPath)\GH_Calcpad</DistDir>
    <DistZip>$(DesktopPath)\GH_Calcpad.zip</DistZip>
  </PropertyGroup>

  <PropertyGroup>
    <WorkerPublishDir>$(WorkerProjectDir)bin\publish-selfcontained\</WorkerPublishDir>
  </PropertyGroup>

  <Target Name="PackageZip" AfterTargets="Build">
    <RemoveDir Directories="$(DistDir)" Condition="Exists('$(DistDir)')" />
    <MakeDir Directories="$(DistDir)" />

    <!-- Self-contained publish (embeds its own .NET 10 runtime) for real distribution,
         so end users don't need any runtime installed separately. -->
    <RemoveDir Directories="$(WorkerPublishDir)" Condition="Exists('$(WorkerPublishDir)')" />
    <Exec Command="dotnet publish &quot;$(WorkerProject)&quot; -c Release -r win-x64 --self-contained true -o &quot;$(WorkerPublishDir)&quot;" />

    <ItemGroup>
      <PackFiles Include="$(TargetDir)GH_Calcpad.gha" />
      <PackFiles Include="$(ProjectDir)Documents\Instructivo_GH-Calcpad_V2.pdf" Condition="Exists('$(ProjectDir)Documents\Instructivo_GH-Calcpad_V2.pdf')" />
      <PackFiles Include="$(ProjectDir)..\LICENSE" Condition="Exists('$(ProjectDir)..\LICENSE')" />
      <PackFiles Include="$(ProjectDir)..\THIRD-PARTY-NOTICES.txt" Condition="Exists('$(ProjectDir)..\THIRD-PARTY-NOTICES.txt')" />
      <WorkerPackFiles Include="$(WorkerPublishDir)**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(PackFiles)" DestinationFolder="$(DistDir)" SkipUnchangedFiles="false" />
    <!-- Own subfolder - same reason as BuildAndCopyWorker above. -->
    <Copy SourceFiles="@(WorkerPackFiles)" DestinationFolder="$(DistDir)\$(WorkerOutputSubfolder)%(RecursiveDir)" SkipUnchangedFiles="false" />
    <Delete Files="$(DistZip)" Condition="Exists('$(DistZip)')" />
    <Exec Command="powershell -NoLogo -NoProfile -Command &quot;Compress-Archive -Path '$(DistDir)\*' -DestinationPath '$(DistZip)' -Force&quot;" />
    <Message Text="Created ZIP: $(DistZip)" Importance="High" />
  </Target>
</Project>